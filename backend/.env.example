# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o GitHub.

# conexão com o PostgreSQL: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# (se a senha tiver caracteres especiais como @ # / :, troque por %40 %23 %2F %3A)
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/zt_barber

# porta da API
PORT=3000

# endereço do site que pode chamar a API (Live Server do VS Code)
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# chave que assina o login do painel. Use um texto longo e aleatório (32+ caracteres)
# e NUNCA compartilhe. Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGREDO=troque-por-um-texto-longo-e-aleatorio-de-pelo-menos-32-caracteres
